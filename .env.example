# This root file documents which variables belong where. It is NOT loaded
# directly by any app — copy the relevant values into frontend/.env.local,
# backend/.env, and outlook-addin/.env respectively.

# ---------------------------------------------------------------------------
# FRONTEND (frontend/.env.local) — safe to expose to the browser
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_APP_NAME=SpikeOS
# NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# BACKEND (backend/.env) — server-only, never exposed to the browser
# ---------------------------------------------------------------------------
# APP_MODE=development
# APP_NAME=SpikeOS API
# DEBUG=true
# FRONTEND_URL=http://localhost:3000
# OUTLOOK_ADDIN_URL=https://localhost:5174
# DATA_SOURCE=mock
# AI_PROVIDER=mock
# POWERBI_PROVIDER=mock
# NOTIFICATION_PROVIDER=mock
# ANALYTICS_PROVIDER=mock

# --- Supabase / Postgres (backend only) -------------------------------------
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Microsoft Entra ID / Graph (backend only) ------------------------------
# Also consumed indirectly by outlook-addin/ — see its own .env.example.
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# --- Power BI (backend only, future) ----------------------------------------
# POWERBI_TENANT_ID=
# POWERBI_CLIENT_ID=
# POWERBI_CLIENT_SECRET=
# POWERBI_WORKSPACE_ID=
# POWERBI_REPORT_ID=

# --- AI provider (backend only, read when AI_PROVIDER=real) -----------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-mini

# --- Auth placeholder (backend only) ----------------------------------------
# JWT_SECRET=dev-only-insecure-secret-change-me

# ---------------------------------------------------------------------------
# OUTLOOK ADD-IN (outlook-addin/.env) — separate Vite app, see its README
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_SPIKEOS_URL=http://localhost:3000
# VITE_MICROSOFT_CLIENT_ID=
# VITE_MICROSOFT_TENANT_ID=
# VITE_DEMO_ACCOUNT_TYPE=employee
# VITE_DEMO_EMPLOYEE_ID=emp-alex-johnson
