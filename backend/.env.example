APP_MODE=development
APP_NAME=SpikeOS API
DEBUG=true
FRONTEND_URL=http://localhost:3000
OUTLOOK_ADDIN_URL=https://localhost:5174

# Provider selection — mock requires zero external credentials. Every
# provider defaults to mock; flip one at a time as real credentials/
# implementations become available. See app/providers/factory.py.
DATA_SOURCE=microsoft
AI_PROVIDER=real
POWERBI_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
ANALYTICS_PROVIDER=mock

# --- Supabase / Postgres (only needed once DATA_SOURCE moves off "mock") ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Microsoft Entra ID / Graph -----------------------------------------
# Same app registration is used for: (1) the future real auth provider,
# and (2) the "Resource" the Outlook add-in's Nested App Authentication
# mints a token for. See outlook-addin/README.md for the full setup.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Power BI (future) ---------------------------------------------------
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_REPORT_ID=

# --- AI provider (only read when AI_PROVIDER=real) ------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-mini

# --- Auth placeholder — replaced by Microsoft Entra ID token verification ---
JWT_SECRET=dev-only-insecure-secret-change-me
