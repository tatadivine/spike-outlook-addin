# --- SpikeOS backend ---------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SPIKEOS_URL=http://localhost:3000

# --- SpikeOS identity (demo, until real Entra ID auth ships) ------------
# Same mechanism the web dashboard uses — see backend/app/core/identity.py.
# account_type=employee requires an employee id; administrator does not.
VITE_DEMO_ACCOUNT_TYPE=employee
VITE_DEMO_EMPLOYEE_ID=emp-alex-johnson

# --- Microsoft Entra ID (optional — live inbox mode) ---------------------
# Leave blank to run the add-in against SpikeOS's mock inbox only.
# See README.md for how to obtain these.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
